{
  "policy_ref": "policy/requirement-rules-v2",
  "supersedes_policy_ref": "policy/requirement-rules-v1",
  "decided_at": "2026-09-13",
  "decision_ref": "docs/modules/evidence/adr/adr-first-completion-owner-decisions.md#5-k3--evidence-owned-적용-rule-catalog",
  "referenced_policies": {
    "attachment": "policy/safety-report-attachment-size/v1",
    "deadline": "policy/safety-report-deadline/v1",
    "calendar": "calendar/kr-public-holidays/2026-2027/r1",
    "report_template": "safety-report-policy/v1"
  },
  "applies_to_report_types": [
    "TRAFFIC_VIOLATION",
    "MOTORCYCLE_VIOLATION"
  ],
  "scopes": {
    "EVIDENCE": {
      "always": [
        {
          "code": "evidence.vehicle_number.present",
          "category": "VEHICLE",
          "outcomes": {
            "value_present": "PASS",
            "value_absent": "UNKNOWN"
          }
        },
        {
          "code": "evidence.occurred_at.present",
          "category": "TIME",
          "outcomes": {
            "resolution_status_ok": "PASS",
            "resolution_status_needs_review": "WARN",
            "occurred_at_absent": "UNKNOWN"
          }
        },
        {
          "code": "evidence.visual_event.present",
          "category": "EVIDENCE",
          "outcomes": {
            "visual_event_type_present": "PASS",
            "null_with_user_unsure": "WARN",
            "otherwise_unresolved": "UNKNOWN"
          }
        },
        {
          "code": "evidence.location.present",
          "category": "LOCATION",
          "outcomes": {
            "any_location_value": "PASS",
            "no_location_value": "WARN"
          }
        }
      ],
      "conditional": []
    },
    "FINAL_PACKAGE": {
      "always": [
        {
          "code": "package.asset.report_video.exists",
          "category": "ASSET",
          "outcomes": {
            "available": "PASS",
            "availability_unknown_or_fact_missing": "UNKNOWN",
            "unavailable": "BLOCK"
          }
        },
        {
          "code": "package.event.violation_visible_in_report_video",
          "category": "EVIDENCE",
          "input": "observation_fact",
          "observation_fact": "violation_visible_in_report_video",
          "outcomes": {
            "observed_true": "PASS",
            "observed_false": "BLOCK",
            "not_observed": "UNKNOWN"
          }
        },
        {
          "code": "package.event.pre_context_present",
          "category": "EVIDENCE",
          "input": "observation_fact",
          "observation_fact": "pre_context_present_in_report_video",
          "outcomes": {
            "observed_true": "PASS",
            "observed_false": "BLOCK",
            "not_observed": "UNKNOWN"
          }
        },
        {
          "code": "package.event.post_context_present",
          "category": "EVIDENCE",
          "input": "observation_fact",
          "observation_fact": "post_context_present_in_report_video",
          "outcomes": {
            "observed_true": "PASS",
            "observed_false": "BLOCK",
            "not_observed": "UNKNOWN"
          }
        },
        {
          "code": "package.vehicle.plate_visible_in_report_video",
          "category": "VEHICLE",
          "input": "observation_fact",
          "observation_fact": "plate_visible_in_report_video",
          "outcomes": {
            "observed_true": "PASS",
            "observed_false": "BLOCK",
            "not_observed": "UNKNOWN"
          }
        },
        {
          "code": "package.location.present",
          "category": "LOCATION",
          "outcomes": {
            "display_location_present": "PASS",
            "display_location_absent": "UNKNOWN"
          },
          "open_decision": "D1(Q1). 위치 없는 WARN Package가 허용되면 display_location_absent 매핑을 바꾼 새 revision이 필요하다."
        },
        {
          "code": "package.report.content_length",
          "category": "REPORT_CONTENT",
          "measurement_unit": "report.characters",
          "outcomes": {
            "rendered_within_range": "PASS",
            "rendered_outside_range": "BLOCK",
            "render_inputs_incomplete": "UNKNOWN"
          },
          "render_required_inputs": [
            "occurred_at",
            "package_display_location",
            "vehicle_number",
            "violation_expression",
            "situation_response"
          ]
        },
        {
          "code": "package.evidence.situation_response",
          "category": "EVIDENCE",
          "replaces_code": "package.evidence.situation_unconfirmed",
          "outcomes": {
            "CONFIRMED": "PASS",
            "CORRECTED": "PASS",
            "USER_UNSURE": "WARN",
            "NOT_ASKED_or_absent": "UNKNOWN"
          },
          "template_selection": {
            "CONFIRMED": "tmpl/safety-report-specific-v1",
            "CORRECTED": "tmpl/safety-report-specific-v1",
            "USER_UNSURE": "tmpl/safety-report-generic-v1",
            "NOT_ASKED_or_absent": null
          }
        },
        {
          "code": "package.asset.image.each_size",
          "category": "ASSET",
          "measurement_unit": "asset.bytes",
          "policy_source": "policy/safety-report-attachment-size/v1"
        },
        {
          "code": "package.asset.video.each_size",
          "category": "ASSET",
          "measurement_unit": "asset.bytes",
          "policy_source": "policy/safety-report-attachment-size/v1"
        },
        {
          "code": "package.asset.total_size",
          "category": "ASSET",
          "measurement_unit": "asset.bytes",
          "policy_source": "policy/safety-report-attachment-size/v1"
        },
        {
          "code": "package.asset.image.count",
          "category": "ASSET",
          "measurement_unit": "asset.count",
          "policy_source": "policy/safety-report-attachment-size/v1"
        },
        {
          "code": "package.asset.video.count",
          "category": "ASSET",
          "measurement_unit": "asset.count",
          "policy_source": "policy/safety-report-attachment-size/v1"
        },
        {
          "code": "package.asset.total_count",
          "category": "ASSET",
          "measurement_unit": "asset.count",
          "policy_source": "policy/safety-report-attachment-size/v1"
        },
        {
          "code": "package.deadline.within_policy",
          "category": "DEADLINE",
          "policy_source": "policy/safety-report-deadline/v1"
        }
      ],
      "conditional": [
        {
          "branch": "time_display",
          "selector": {
            "inputs": [
              "time_resolution.status",
              "time_resolution.post_stamp.reason_code"
            ],
            "exactly_one_required": true,
            "note": "post_stamp.needed 단독으로 분기하지 않는다. status=UNKNOWN이면 needed=false이지만 검증된 overlay가 있다는 뜻이 아니다."
          },
          "cases": [
            {
              "when": {
                "status": "OK",
                "post_stamp_reason_code": "time.verified_overlay_already_present"
              },
              "code": "package.time.overlay_visible",
              "category": "TIME",
              "input": "observation_fact",
              "observation_fact": "time_overlay_visible",
              "outcomes": {
                "observed_true": "PASS",
                "observed_false": "BLOCK",
                "not_observed": "UNKNOWN"
              }
            },
            {
              "when": {
                "status": "OK",
                "post_stamp_reason_code": "time.user_confirmed_no_overlay_present"
              },
              "code": "package.time.post_stamp_applied",
              "category": "TIME",
              "input": "observation_fact",
              "observation_fact": "post_stamp_applied",
              "outcomes": {
                "observed_true": "PASS",
                "observed_false": "BLOCK",
                "not_observed": "UNKNOWN"
              },
              "user_notice": "non_blocking"
            },
            {
              "when": {
                "status": "NEEDS_REVIEW",
                "post_stamp_reason_code": "time.no_verified_overlay_present"
              },
              "code": "package.time.post_stamp_applied",
              "category": "TIME",
              "input": "observation_fact",
              "observation_fact": "post_stamp_applied",
              "outcomes": {
                "observed_true": "PASS",
                "observed_false": "BLOCK",
                "not_observed": "UNKNOWN"
              }
            },
            {
              "when": {
                "status": "UNKNOWN",
                "post_stamp_reason_code": "time.no_resolvable_source"
              },
              "code": "package.time.display_unresolved",
              "category": "TIME",
              "outcomes": {
                "always": "UNKNOWN"
              },
              "reason_code": "time.source_unresolved"
            }
          ]
        }
      ]
    }
  },
  "asset_requirements": {
    "REPORT_VIDEO": "REQUIRED",
    "PLATE_IMAGE": "OPTIONAL",
    "ORIGINAL_SOURCE_ATTACHMENT": "OPTIONAL"
  },
  "not_stored": [
    "pre_event_seconds",
    "post_event_seconds",
    "internal_target_bytes",
    "pc_vs_mobile_catalog_split"
  ],
  "policy_configuration_errors": [
    "unknown_policy_ref",
    "no_matching_catalog_entry",
    "multiple_matching_catalog_entries",
    "unsupported_rule_code",
    "empty_selected_rule_list",
    "duplicate_rule_code",
    "time_display_branch_not_exactly_one",
    "attachment_limit_data_missing_or_malformed",
    "deadline_calendar_coverage_missing_or_malformed",
    "selector_value_malformed_or_unregistered",
    "observation_fact_malformed"
  ]
}

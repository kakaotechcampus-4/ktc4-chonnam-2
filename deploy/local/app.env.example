# deploy/local/secrets/app.env로 복사한 뒤 예시 credential을 바꾼다.
# MySQL password는 deploy/local/secrets/mysql-password와 일치해야 한다.
DAESINGO_RUNTIME_DB_URL=mysql+pymysql://daesingo:replace-me@mysql/daesingo
DAESINGO_RUNTIME_MEDIA_ROOT=/srv/daesingo/media
DAESINGO_RUNTIME_API_TEMP_ROOT=/srv/daesingo/api-temp
DAESINGO_RUNTIME_WORKER_TEMP_ROOT=/srv/daesingo/worker-temp

# 현재 Worker bootstrap에는 이 legacy key가 필요하다. RT-10에서 바뀔 수 있다.
GEMINI_API_KEY=replace-me

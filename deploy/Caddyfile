{
	# No request paths, query strings or private upstream errors in journal.
	log default {
		output discard
	}
}

# Operator supplies a bare public hostname in the host service environment.
{$RT14_PUBLIC_HOSTNAME} {
	@api path /cases* /health*
	handle @api {
		header Cache-Control "no-store"
		reverse_proxy 127.0.0.1:8000
	}
	handle {
		root * /srv/daesingo/current
		header Cache-Control "no-store"
		file_server
	}
}

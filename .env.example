# Gemini 검색/평가 설정. 이 파일을 `.env` 로 복사해 채운다.
# 모든 설정은 `.env` 에서만 읽는다 (shell 환경변수는 사용하지 않는다).

# 필수 — Elice ML API 키 (프록시 Bearer 인증에 사용)
# 기존 이름 GEMINI_API_KEY도 당분간 읽는다(Search config alias, #153). 새로 만들 땐 이 이름을 쓴다.
ELICE_ML_API_KEY=

# eval 담당자 로컬 데이터 루트 (clips.json 의 file_path 기준 경로)
DAESINGO_EVAL_DATA_ROOT=

# eval 비공개 루트 — private_ manifest(차량번호가 든 정답·예측·결과)를 레포 밖에 둔다
DAESINGO_EVAL_PRIVATE_ROOT=

# 선택 — 미지정 시 코드 기본값 사용
# DAESINGO_GEMINI_MODEL=gemini-4-argon
# DAESINGO_GEMINI_BASE_URL=https://mlapi.run/<tenant>/v1
# DAESINGO_INTENT_MODEL=gemini-3.8-flash
# DAESINGO_INTENT_BASE_URL=https://mlapi.run/<tenant>/v1

# RT-13 local runtime 파일 예시. Compose environment/env_file로 전달하지 않는다.
# 실제 파일은 repo 밖에 두고 container UID/GID 10001:10001, 0400으로 준비한다.
# 아래 placeholder를 실제 값으로 바꾸고 비밀값을 로그/argv에 넣지 않는다.
# DAESINGO_RUNTIME_DB_URL=mysql+pymysql://daesingo:<url-encoded-password>@mysql/daesingo
# DAESINGO_RUNTIME_MEDIA_ROOT=/media
# DAESINGO_RUNTIME_API_TEMP_ROOT=/media/api-temp
# DAESINGO_RUNTIME_WORKER_TEMP_ROOT=/media/worker-temp
# 기존 Worker bootstrap은 GEMINI_API_KEY를 필수로 검증한다.
# GEMINI_API_KEY=<provider-key>
# 선택: DAESINGO_RUNTIME_LOG_LEVEL=INFO (B-O2 기본값)
# Compose shell에는 값 대신 아래 host 파일 경로만 설정한다.
# DAESINGO_RUNTIME_ENV_FILE=<absolute-protected-runtime-env-path>
# DAESINGO_MYSQL_ROOT_PASSWORD_FILE=<absolute-protected-root-password-file>
# DAESINGO_MYSQL_PASSWORD_FILE=<absolute-protected-app-password-file>
# 상세 설정/검증/후속 범위: docs/runtime/rt13a-docker-compose.md
# DAESINGO_GEMINI_MEDIA_RESOLUTION=low

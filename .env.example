# 로컬 Runtime/Ops·Recording canonical guide:
# docs/runtime/local-runtime-environment.md (Refs #460)
# 이 파일은 완성된 실행 설정이 아니다. 빈 필수값을 채운 보호 파일로 사용한다.
# 실제 key/DB URL/개인 경로를 Git에 저장하지 않는다.
# API/Worker 설정은 DAESINGO_ENV_FILE이 선택한 파일(기본 cwd/.env)에서만 읽는다.
# shell의 같은 이름 설정은 병합하지 않는다. Compose 파일 선택자는 아래 별도 경계다.

# Search 공용/eval: ELICE 우선, GEMINI alias 지원. 실제 발급값은 개인별 secret.
ELICE_ML_API_KEY=
# 현재 기본 Worker bootstrap은 이 이름을 필수로 읽는다. ELICE만으로 대체 불가.
GEMINI_API_KEY=

# Runtime 필수. DB password는 URL encoding; MySQL app password 파일과 일치시킨다.
# Compose URL 형태: mysql+pymysql://daesingo:<url-encoded-password>@mysql/daesingo
DAESINGO_RUNTIME_DB_URL=
# 아래는 Compose 컨테이너 경로 예시. native 실행은 배포자가 준비한 로컬 경로로 변경.
DAESINGO_RUNTIME_MEDIA_ROOT=/media
DAESINGO_RUNTIME_API_TEMP_ROOT=/media/api-temp
DAESINGO_RUNTIME_WORKER_TEMP_ROOT=/media/worker-temp

# Recording: 대표 encoding 미확정, 코드 기본값 없음. 빈 값은 의도적인 미완성 표시.
# Analysis 6개/Incident 3개는 각각 모두 채운다. height 양의 짝수, CRF 0..51.
# preset: ultrafast/superfast/veryfast/faster/fast/medium/slow.
# #460의 임시 480/240·veryfast·23은 운영 권장값이 아니다. #452 용량/시간 측정 필요.
DAESINGO_RECORDING_ANALYSIS_PROFILE_REF=
DAESINGO_RECORDING_ANALYSIS_HEIGHT=
DAESINGO_RECORDING_ANALYSIS_PRESET=
DAESINGO_RECORDING_ANALYSIS_CRF=
# #452: 기본값 없음. 두 값 모두 양의 정수. bytes / milliseconds, 경계와 같으면 허용.
# 운영 DB packet/driver overhead와 실제 Runtime profile 측정 후 Owner가 확정한다.
DAESINGO_RECORDING_ANALYSIS_MAX_BYTES=
DAESINGO_RECORDING_ANALYSIS_MAX_DURATION_MS=
DAESINGO_RECORDING_INCIDENT_HEIGHT=
DAESINGO_RECORDING_INCIDENT_PRESET=
DAESINGO_RECORDING_INCIDENT_CRF=
# 선택: 파일명 시각에 적용할 명시적 ±HH:MM. 미설정 시 timezone을 추측하지 않는다.
# DAESINGO_RECORDING_FILENAME_OFFSET=+09:00

# Search Coarse/Fine: 미지정 시 아래 코드 기본값. model/base URL은 한 쌍으로 확인.
# 예전 Flash override는 두 줄 모두 제거하거나 argon 쌍으로 교체한다(#429).
# DAESINGO_GEMINI_MODEL=gemini-4-argon
# DAESINGO_GEMINI_BASE_URL=https://mlapi.run/e1febb2a-0530-4f93-9ff4-ef844e185639/v1
# DAESINGO_GEMINI_MEDIA_RESOLUTION=low
# Intent는 별도 Flash 쌍. Search argon 경로를 복사하지 않는다.
# DAESINGO_INTENT_MODEL=gemini-3.8-flash
# DAESINGO_INTENT_BASE_URL=https://mlapi.run/a90d8545-f100-4276-bf86-eb774596b91d/v1
# 선택 가격/예산: 코드 기본값 0.0, 실제 단가나 예산 대표값이 아님.
# DAESINGO_GEMINI_INPUT_USD_PER_MILLION=0.0
# DAESINGO_GEMINI_OUTPUT_USD_PER_MILLION=0.0
# DAESINGO_GEMINI_MAX_COST_USD=0.0

# Runtime 선택값의 전체 이름/소비 서비스/기본값은 canonical guide의 표 참조.
# DAESINGO_RUNTIME_LOG_LEVEL=INFO
# Readout: 기본 Worker가 production PaddleOCR 자동 조립. provider 선택 env 없음.
# 이미지 고정 cache /opt/daesingo/paddlex; .env로 cache/model을 선택하지 않는다.

# 아래 키는 앱 파일 내용이 아니라 Compose 호스트 shell의 파일 선택자다.
# repo 밖 파일: runtime은 UID/GID 10001:10001 mode 0400;
# MySQL 두 파일은 실제 mysql image의 mysql UID/GID mode 0400. Linux host에서 준비.
# DAESINGO_RUNTIME_ENV_FILE=<protected-runtime-env-file>
# DAESINGO_MYSQL_ROOT_PASSWORD_FILE=<protected-root-password-file>
# DAESINGO_MYSQL_PASSWORD_FILE=<protected-app-password-file>
# DAESINGO_REVISION=<source-revision>  (선택 build identity, 기본 local)
# DAESINGO_API_PORT=8000             (선택 host loopback port)
# 앱을 native 실행할 때만 shell DAESINGO_ENV_FILE=<protected-runtime-env-file> 선택.
# Compose는 /run/secrets/runtime.env로 bind하고 이 앱 선택자를 직접 지정한다.

# eval 전용 선택 경로. Runtime 필수값이 아니며 비공개 데이터는 repo 밖에 둔다.
# clips.json file_path 기준 root / private_ manifest root.
DAESINGO_EVAL_DATA_ROOT=
DAESINGO_EVAL_PRIVATE_ROOT=
